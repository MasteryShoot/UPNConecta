<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o mayor: la sesión y su token no van a la nube ni a otro teléfono -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="upn_conecta_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="upn_conecta_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
