# Copia este archivo como local.properties. Android Studio agrega sdk.dir por su cuenta.
# Clave de Google Maps (restringida en Google Cloud al paquete y SHA-1 de la app).
# Sin ella la app funciona, pero el mapa de Explorar sale en blanco.
MAPS_API_KEY=tu_clave_de_google_maps

# Opcional: usar el backend corriendo en tu PC en vez del publicado en Render
# API_URL=http://10.0.2.2:8080/api/
