<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet para cargar el mapa y ubicación para mostrar las sedes cercanas -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.UPNConecta">

        <!-- API key de Google Maps (se define en local.properties como MAPS_API_KEY) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".inicio.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.UPNConecta.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".usuario.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".usuario.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".sede.ElegirSedeActivity"
            android:exported="false" />

        <activity
            android:name=".inicio.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".sede.DetalleAreaActivity"
            android:exported="false" />

        <activity
            android:name=".sede.CalificarAreaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".sede.ComentariosSedeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".profesor.ProfesoresActivity"
            android:exported="false" />

        <activity
            android:name=".profesor.EvaluacionProfesorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".explorar.ExplorarActivity"
            android:exported="false" />

        <activity
            android:name=".sorteo.SorteosActivity"
            android:exported="false" />

        <activity
            android:name=".usuario.PerfilActivity"
            android:exported="false" />
    </application>
</manifest>
